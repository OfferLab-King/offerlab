{
  "name": "offerlab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OfferLab modular monolith technical foundation",
  "engines": {
    "node": "24.x",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "dev:bypass": "tsx scripts/run-local-bypass.ts",
    "dev:jobs": "tsx scripts/dev-with-jobs.ts",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:no-reset": "tsx scripts/run-e2e.ts --skip-reset",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:validate": "pnpm db:reset",
    "db:new-migration": "supabase migration new",
    "db:seed": "pnpm db:reset",
    "seed:learn-demo": "tsx scripts/seed-learn-demo.ts",
    "seed:answer-bank-demo": "tsx scripts/seed-answer-bank-demo.ts",
    "db:types": "supabase gen types typescript --local > src/infrastructure/database/generated.types.ts && prettier --write src/infrastructure/database/generated.types.ts",
    "env:check": "tsx scripts/validate-environment.ts",
    "env:example:check": "tsx scripts/validate-environment-example.ts",
    "admin:promote": "tsx scripts/promote-administrator.ts",
    "auth-rate-limits:cleanup": "tsx scripts/cleanup-auth-rate-limits.ts",
    "jobs:test": "pnpm test:unit",
    "jobs:crawl": "tsx scripts/jobs/crawl-company.ts",
    "jobs:crawl:due": "tsx scripts/jobs/crawl-due.ts",
    "jobs:enrich": "tsx scripts/jobs/enrich.ts",
    "jobs:seed-companies": "tsx scripts/jobs/seed-companies.ts",
    "jobs:status": "tsx scripts/jobs/status.ts",
    "jobs:clean-synthetic-catalog": "tsx scripts/jobs/clean-synthetic-catalog.ts",
    "jobs:targets:validate": "tsx scripts/jobs/targets/validate.ts",
    "jobs:targets:export": "tsx scripts/jobs/targets/export.ts",
    "jobs:targets:import": "tsx scripts/jobs/targets/import.ts",
    "jobs:discover-source": "tsx scripts/jobs/discover-source.ts",
    "jobs:taxonomy:backfill": "tsx scripts/jobs/taxonomy-backfill.ts",
    "jobs:reclassify": "tsx scripts/jobs/reclassify.ts",
    "jobs:verify-sources": "tsx scripts/jobs/verify-sources.ts",
    "security:audit": "pnpm audit --audit-level high",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "drizzle-orm": "0.45.2",
    "mammoth": "1.12.0",
    "next": "16.2.11",
    "node-html-parser": "9.0.1",
    "pdfjs-dist": "6.2.108",
    "pino": "10.3.1",
    "playwright": "1.61.1",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
